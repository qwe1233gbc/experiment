  {
    "standard_id": "STD-DIFY-06-005",
    "title": "城市污水再生利用 城市杂用水水质 GB/T 18920-2020 限值",
    "domain": "环境质量标准",
    "card_type": "limit",
    "skill_ids": [
      "06_环境质量执行标准",
      "07_污染物排放标准"
    ],
    "workflow_ids": [
      "7-环境质量执行标准准确性判断",
      "8-污染物排放标准内容判断"
    ],
    "source_files": [
      "03_指南解析_明文标准库/Dify工作流知识库/GB_T_18920-2020.md"
    ],
    "source_basis": [
      "GB/T 18920-2020 城市污水再生利用 城市杂用水水质"
    ],
    "applicable_scope": "用于项目使用再生水作为城市杂用水（冲厕、车辆冲洗、建筑施工、消防、混凝土生产、道路清扫、绿化灌溉等）时的水质标准核对。",
    "trigger_keywords": [
      "GB/T 18920",
      "城市杂用水",
      "再生水",
      "城市污水再生利用",
      "冲厕用水",
      "车辆冲洗",
      "消防用水",
      "建筑施工用水",
      "绿化灌溉",
      "道路清扫"
    ],
    "evidence_fields": [
      "用水用途",
      "再生水来源",
      "水质指标",
      "报告限值",
      "执行标准"
    ],
    "normative_requirements": [
      "冲厕、道路清扫、城市绿化用再生水应符合表1第3列限值。",
      "车辆冲洗、建筑施工、消防、混凝土生产用再生水应符合表1第4列限值。",
      "基本控制项目包括pH、悬浮物、色度、浊度、BOD5、氨氮、阴离子表面活性剂、铁、锰、溶解性总固体、溶解氧、总余氯、粪大肠菌群共13项。",
      "选择控制项目包括氯离子和硫酸根，限值分别为≤350 mg/L和≤500 mg/L。"
    ],
    "thresholds": [
      {
        "factor": "pH",
        "limit": "6.0-9.0",
        "scenario": "所有杂用水用途"
      },
      {
        "factor": "悬浮物(SS)",
        "limit": "≤15 mg/L (冲厕/道路清扫/绿化); ≤30 mg/L (车辆冲洗/建筑施工/消防/混凝土)",
        "unit": "mg/L"
      },
      {
        "factor": "色度",
        "limit": "≤30",
        "scenario": "所有杂用水用途"
      },
      {
        "factor": "浊度",
        "limit": "≤5 NTU (冲厕/道路清扫/绿化); ≤10 NTU (车辆冲洗/建筑施工/消防/混凝土)",
        "unit": "NTU"
      },
      {
        "factor": "BOD5",
        "limit": "≤10 mg/L",
        "scenario": "所有杂用水用途"
      },
      {
        "factor": "氨氮",
        "limit": "≤5 mg/L (冲厕/道路清扫/绿化); ≤8 mg/L (车辆冲洗/建筑施工/消防/混凝土); ≤2.5 mg/L (混凝土生产)",
        "unit": "mg/L"
      },
      {
        "factor": "阴离子表面活性剂",
        "limit": "≤0.5 mg/L",
        "scenario": "所有杂用水用途"
      },
      {
        "factor": "铁",
        "limit": "≤0.3 mg/L (冲厕/道路清扫/绿化); 无要求 (车辆冲洗/建筑施工/消防/混凝土)",
        "unit": "mg/L"
      },
      {
        "factor": "锰",
        "limit": "≤0.1 mg/L (冲厕/道路清扫/绿化); 无要求 (车辆冲洗/建筑施工/消防/混凝土)",
        "unit": "mg/L"
      },
      {
        "factor": "溶解性总固体",
        "limit": "≤1000 mg/L (2000 mg/L上限)",
        "unit": "mg/L"
      },
      {
        "factor": "溶解氧",
        "limit": "≥2.0 mg/L",
        "scenario": "所有杂用水用途"
      },
      {
        "factor": "总余氯",
        "limit": "≥1.0 mg/L (管网末端); ≥0.2 mg/L (管网末端)",
        "unit": "mg/L"
      },
      {
        "factor": "粪大肠菌群",
        "limit": "不得检出",
        "unit": "MPN/100mL 或 CFU/100mL"
      },
      {
        "factor": "氯离子(Cl-)",
        "limit": "≤350 mg/L",
        "scenario": "选择控制项目"
      },
      {
        "factor": "硫酸根(SO4²-)",
        "limit": "≤500 mg/L",
        "scenario": "选择控制项目"
      }
    ],
    "formulas": [],
    "check_logic": [
      "识别报告中再生水用途类型（冲厕/车辆冲洗/建筑施工/消防/混凝土生产/道路清扫/绿化灌溉）。",
      "根据用途选择表1对应列的限值进行核对。",
      "逐项核对报告中的水质指标是否满足对应限值。",
      "检查是否遗漏基本控制项目（13项必查）。",
      "如有混凝土生产用途，额外核对氨氮≤2.5 mg/L。",
      "核对选择控制项目（氯离子、硫酸根）是否已检测。",
      "报告中未列明再生水用途时，提示补充用途分类。"
    ],
    "output_fields": [
      "standard_id",
      "matched_evidence",
      "judgement",
      "risk_level",
      "reason",
      "suggested_revision"
    ],
    "manual_review": [
      "报告未明确再生水具体用途。",
      "基本控制项目不完整（少于13项）。",
      "再生水用途为混凝土生产但未检测氨氮。",
      "总余氯未标注取样位置（管网末端）。"
    ],
