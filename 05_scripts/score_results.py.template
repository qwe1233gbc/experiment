for row in ws_q.iter_rows(min_row=2, values_only=True):
    if row[0] is None: continue
    q = dict(zip(q_headers, row))
    questions[q["题号"]] = q

def extract_answer_section(text):
    """提取【答案】部分内容"""
    if not text: return ""
    m = re.search(r'【答案】\s*\n?(.*?)(?=\n【|$)', text, re.DOTALL)
    if m:
        return m.group(1).strip()
    m = re.search(r'答案[：:]\s*\n?(.*?)(?=\n推理|\n计算|\n$)', text, re.DOTALL)
    if m:
        return m.group(1).strip()
    return text[:800]

def close_num(val, target, tol=0.15):
    """数值是否在容差范围内"""
    if target == 0: return val == 0
    return abs(val - target) / abs(target) < tol

def score_choice(ans_section, gold_letter):
    """A类选择题评分"""
    # 提取选项字母：答案部分第一行的字母
    first_line = ans_section.strip().split('\n')[0].strip()
    # 匹配 "D" 或 "D. 丁企业" 或 "D.丁企业"
    m = re.match(r'^([A-D])[\.、\s]*', first_line)
    if m:
        return m.group(1) == gold_letter
    # 也检查整个答案部分
    m = re.search(r'\b([A-D])[\.、]', ans_section)
    if m:
        return m.group(1) == gold_letter
    # 检查是否包含正确答案的文字
    return False

def score_q(qid, model_answer, gold_answer, q_data):
    """逐题评分"""
    ans_section = extract_answer_section(model_answer)
    cat = q_data.get("类别", "")
    sub = q_data.get("子题型", "")
    
    # ===== A 类：选择题 =====
    if cat.startswith("A"):
        gold_m = re.search(r'([A-D])\.', gold_answer)
        gold_l = gold_m.group(1) if gold_m else ""
        correct = score_choice(ans_section, gold_l)
        if correct:
            return 1, "", "选项正确"
        # 检查推理过程中的结论
        reasoning = model_answer or ""
        if f"选{gold_l}" in reasoning or f"选 {gold_l}" in reasoning or f"选项{gold_l}" in reasoning:
            return 1, "", "推理结论正确"
        return 0, "逻辑错误", f"答案选项错误（Gold={gold_l}）"
    
    # ===== B 类：计算题 =====
    if cat.startswith("B"):
        # 提取答案中的所有数字
        ans_nums = [float(x) for x in re.findall(r'(\d+(?:\.\d+)?)', ans_section)]
        gold_nums = [float(x) for x in re.findall(r'(\d+(?:\.\d+)?)', gold_answer)]
        
        if not ans_nums:
            return 0, "计算错误", "未提取到数值"
        
        # 逐题定制评分
        if "B01" in qid:
            # 找 20150 附近的值
            for n in ans_nums:
                if close_num(n, 20150, 0.02):
                    return 1, "", "标态干烟气流量计算正确"
            return 0, "计算错误", f"数值不符：{ans_nums[:5]}"
        
        if "B02" in qid:
            # 三个值：100, 10, 187.5
            has_100 = any(close_num(n, 100, 0.05) for n in ans_nums)
            has_10 = any(close_num(n, 10, 0.1) for n in ans_nums)
            has_187 = any(close_num(n, 187.5, 0.05) for n in ans_nums)
            correct = sum([has_100, has_10, has_187])
            if correct == 3:
                return 1, "", "SVI/SRT/排泥量全部正确"
            elif correct >= 2:
                return 0.67, "部分正确", f"对{correct}/3小问"
            else:
                return 0, "计算错误", f"对{correct}/3小问"
        
        if "B03" in qid:
            has_967 = any(close_num(n, 96.7, 0.02) for n in ans_nums)
            has_114 = any(close_num(n, 11.4, 0.1) for n in ans_nums)
            has_6566 = any(close_num(n, 6566, 0.05) for n in ans_nums)
            correct = sum([has_967, has_114, has_6566])
            if correct == 3:
                return 1, "", "效率/功率/电费全部正确"
            elif correct >= 2:
                return 0.67, "部分正确", f"对{correct}/3小问"
            else:
                return 0, "计算错误", f"对{correct}/3小问"
    
    # ===== C 类：冲突识别 =====
    if cat.startswith("C"):
        reasoning_full = model_answer or ""
        
        if "C01" in qid:
            # 2处冲突 + 总量章节更合理
            has_2 = "2处" in ans_section or "两处" in ans_section or "2 处" in ans_section
            has_reasonable = "1800" in ans_section and ("合理" in ans_section or "更" in reasoning_full)
            if has_2 and has_reasonable:
                return 1, "", "冲突数量正确，判断合理"
            elif has_2:
                return 0.5, "部分正确", "找到2处但合理性判断不明确"
            else:
                return 0, "信息遗漏", "未正确识别冲突数量"
        
        if "C02" in qid:
            # DA003不一致 + 达标判断
            has_da003 = "DA003" in reasoning_full or "第三根" in reasoning_full
            has_pred_ok = "达标" in ans_section and "60" in ans_section
            has_eng_ok = "达标" in reasoning_full and "100" in reasoning_full
            has_self = "自洽" in reasoning_full or "一致" in reasoning_full
            score = sum([has_da003, has_pred_ok, has_eng_ok]) / 4
            if score >= 0.75:
                return 1, "", "不一致识别+达标判断正确"
            elif score >= 0.5:
                return 0.5, "部分正确", "部分判断正确"
            else:
                return 0, "信息遗漏", "关键判断错误"
        
        if "C03" in qid:
            # 3处冲突 + 1800
            has_3 = "3处" in ans_section or "三处" in ans_section or "3 处" in ans_section
            has_1800 = any(close_num(float(n), 1800, 0.01) for n in re.findall(r'(\d+)', ans_section) if n.isdigit() and int(n) > 1000)
            if has_3 and has_1800:
                return 1, "", "3处冲突+用水量都对"
            elif has_3:
                return 0.5, "部分正确", "找到3处但用水量计算待确认"
            else:
                return 0, "信息遗漏", "冲突数量识别错误"
    
    # ===== D 类：专业知识 =====
    if cat.startswith("D"):
        reasoning_full = model_answer or ""
        
        if "D01" in qid:
            if "报告表" in ans_section and ("提升" in reasoning_full or "危险化学品" in reasoning_full):
                return 1, "", "分类+理由正确"
            elif "报告表" in ans_section:
                return 0.7, "部分正确", "结论正确但理由可能不完整"
            else:
                return 0, "规则误用", "分类判定错误"
        
        if "D02" in qid:
            has_4a = "4a" in ans_section.lower() or "4a类" in reasoning_full
            has_2 = "2类" in ans_section or "2类" in reasoning_full
            has_country = "乡村" in reasoning_full and ("改变" in reasoning_full or "不同" in reasoning_full or "2类或3类" in reasoning_full)
            correct = sum([has_4a, has_2, has_country])
            if correct == 3:
                return 1, "", "东厂界+南厂界+乡村都对"
            elif correct == 2:
                return 0.67, "部分正确", "对2/3小问"
            else:
                return 0.33, "部分正确", "对1/3小问"
        
        if "D03" in qid:
            has_oil = "废切削液" in ans_section and "废机油" in ans_section
            has_barrel = "废包装桶" in ans_section or "包装物" in reasoning_full
            has_not_sure = "不一定" in ans_section or "需鉴别" in reasoning_full or "需要鉴别" in reasoning_full
            has_clean = "不一定" in reasoning_full and "清洗" in reasoning_full
            correct = sum([has_oil, has_barrel, has_not_sure])
            if correct >= 2 and has_oil:
                return 1 if correct == 3 else 0.67, "部分正确" if correct < 3 else "", f"危废识别对{correct}/3小问"
            else:
                return 0.33, "部分正确", "识别不完整"
    
    # ===== E 类：反事实推理 =====
    if cat.startswith("E"):
        if "E01" in qid:
            reasoning_full = model_answer or ""
            has_450 = any(close_num(float(n), 450, 0.05) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            has_y_no = "不变" in ans_section or "不改变" in ans_section
            has_3556 = any(close_num(float(n), 3556, 0.05) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            correct = sum([has_450, has_y_no, has_3556])
            if correct == 3:
                return 1, "", "净增量+Y不变+MLSS都对"
            elif correct >= 2:
                return 0.67, "部分正确", f"对{correct}/3小问"
            else:
                return 0, "计算错误", f"对{correct}/3小问"
        
        if "E02" in qid:
            reasoning_full = model_answer or ""
            has_12 = any(close_num(float(n), 1.2, 0.1) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            has_15 = any(close_num(float(n), 1.5, 0.1) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            has_21 = any(close_num(float(n), 21.25, 0.1) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            has_conc = "不影响" in reasoning_full and "浓度" in reasoning_full
            correct = sum([has_12, has_15, has_21])
            if correct >= 2:
                return 1 if correct == 3 else 0.67, "", f"速率计算对{correct}/3"
            else:
                return 0.5, "部分正确", "计算部分正确"
        
        if "E03" in qid:
            has_108 = any(close_num(float(n), 108, 0.05) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            has_129 = any(close_num(float(n), 129.6, 0.05) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            has_69 = any(close_num(float(n), 69.1, 0.05) for n in re.findall(r'(\d+(?:\.\d+)?)', ans_section))
            correct = sum([has_108, has_129, has_69])
            if correct == 3:
                return 1, "", "出水+不达标+好氧效率都对"
            elif correct >= 2:
                return 0.67, "部分正确", f"对{correct}/3小问"
            else:
                return 0.33, "部分正确", f"对{correct}/3小问"
    
    return 0.5, "待人工复核", "无法自动判定"

# 评分
results = {}
for r in rows:
    qid = r["question_id"]
    model = r["model_condition"]
    q_data = questions.get(qid, {})
    gold = r.get("gold_answer", "")
    raw = r.get("raw_answer", "")
    
    score, err_type, note = score_q(qid, raw, gold, q_data)
    
    if qid not in results:
        results[qid] = {}
    results[qid][model] = {
        "score": score,
        "error_type": err_type,
        "note": note,
        "raw_preview": raw[:300] + "..." if len(raw) > 300 else raw,
        "latency": r.get("latency"),
        "output_tokens": r.get("output_tokens"),
        "status": r.get("status"),
    }

