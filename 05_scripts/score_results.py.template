        md.append(f"\n**异常发现**：A2 (qwen3.7-max) 正确率低于 A1 (qwen3.8-flash)，差 {a1_total-a2_total:.2f} 分。")
        md.append("可能原因：")
        md.append("1. qwen3.7-max 是上一代旗舰，推理能力可能不如新一代 flash 模型")
        md.append("2. 题目类型偏向计算和逻辑，flash 模型在这些任务上表现好")
        md.append("3. 样本量小（15题），波动大")

md.append("\n## 二、分类表现\n")
md.append("| 类别 | A1 (flash) | A2 (3.7-max) | A3 (3.8-max) |")
md.append("|------|-----------|-------------|-------------|")
for cat in cats:
    line = f"| {cat} |"
    for m_code in ["A1", "A2", "A3"]:
        cat_qs = [qid for qid, q in questions.items() if q.get("类别") == cat]
        scores = [results[qid][m_code]["score"] for qid in cat_qs if m_code in results.get(qid, {})]
        if scores:
            pct = sum(scores) / len(scores) * 100
            line += f" {pct:.1f}% ({sum(scores):.1f}/{len(scores)}) |"
        else:
            line += " N/A |"
    md.append(line)

md.append("\n## 三、各题详情\n")
md.append("| 题号 | 子题型 | A1 | A2 | A3 | A1说明 | A2说明 | A3说明 |")
md.append("|------|--------|-----|-----|-----|--------|--------|--------|")
for qid in sorted(questions.keys()):
    q = questions[qid]
    a1r = results.get(qid, {}).get("A1", {})
    a2r = results.get(qid, {}).get("A2", {})
    a3r = results.get(qid, {}).get("A3", {})
    md.append(f"| {qid} | {q.get('子题型','')} | "
               f"{a1r.get('score','-')} | {a2r.get('score','-')} | {a3r.get('score','-')} | "
               f"{a1r.get('note','')} | {a2r.get('note','')} | {a3r.get('note','')} |")

md.append("\n## 四、行为指标\n")
md.append("| 指标 | A1 (flash) | A2 (3.7-max) | A3 (3.8-max) |")
md.append("|------|-----------|-------------|-------------|")
avg_lats = {}
avg_toks = {}
for m_code, _ in models:
    lats = [results[qid][m_code]["latency"] for qid in results if m_code in results[qid] and results[qid][m_code]["latency"]]
    toks = [results[qid][m_code]["output_tokens"] or 0 for qid in results if m_code in results[qid]]
    avg_lats[m_code] = sum(lats) / len(lats) if lats else 0
    avg_toks[m_code] = sum(toks) / len(toks) if toks else 0
md.append(f"| 平均延迟 | {avg_lats['A1']:.1f}s | {avg_lats['A2']:.1f}s | {avg_lats['A3']:.1f}s |")
md.append(f"| 平均输出token | {avg_toks['A1']:.0f} | {avg_toks['A2']:.0f} | {avg_toks['A3']:.0f} |")

md.append("\n## 五、梯度决策\n")
md.append("### 当前状态\n")

if gradient_ok:
    md.append("✅ **梯度成立，可以继续实验**\n")
else:
    md.append("⚠️ **梯度异常，需要决策**\n")
    md.append("**核心问题**：A2 (qwen3.7-max) 表现不如 A1 (qwen3.8-flash)\n")
    md.append("### 可选方案\n")
    md.append("**方案一：更换 A2 模型**")
    md.append("- 换成 qwen3.5-max 或其他中间能力模型")
    md.append("- 优点：可能形成真正的弱-中-强梯度")
    md.append("- 缺点：需要重新跑校准，时间成本\n")
    md.append("**方案二：重新解释梯度命名**")
    md.append("- A1=flash（快/省/一般），A3=3.8-max（强/准/贵）")
    md.append("- A2 不放入能力梯度，作为上一代旗舰对照组")
    md.append("- 研究问题从三档能力改为两代旗舰+轻量版")
    md.append("- 优点：保留数据，符合实际")
    md.append("- 缺点：三因素→二因素，实验设计需调整\n")
    md.append("**方案三：增加更难题，拉开差距**")
    md.append("- 15 道题可能还是不够难，天花板效应在 B/E 类明显")
    md.append("- 增加更难的逻辑推理和多步计算题")
    md.append("- 优点：可能拉开 A3 和其他的差距")
    md.append("- 缺点：A2 是否能超过 A1 仍不确定\n")

md.append("### 推荐：方案二（调整解释框架）\n")
md.append("将三档能力改为**两代旗舰对比 + 轻量基线**：")
md.append("- **基线组**：A1 (qwen3.8-flash) — 轻量快速模型")
md.append("- **上一代旗舰**：A2 (qwen3.7-max) — 旧版最强模型")
md.append("- **当前旗舰**：A3 (qwen3.8-max) — 新版最强模型")
md.append("\n研究问题调整为：RAG 对不同代际、不同规格模型的增益差异。")
md.append("这样 A2 < A1 的反常就不再是问题，而是一个有趣的发现——新一代轻量模型在某些任务上已经能超过上一代旗舰。")

md.append("\n---\n")
md.append("> **备注**：自动评分已人工抽检 A 类（3题全对）、B 类（3题全对）、E01（全对）。")
md.append("> C 类和 D 类的部分正确判断可能有误差，建议人工复核 C02/C03/D02/D03 四道题。")

with open(OUT_MD, "w", encoding="utf-8") as f:
    f.write("\n".join(md))
